{
  "cli": {
    "version": ">= 21.3.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "node": "22.19.0",
      "env": {
        "EAS_NO_VCS": "1",
        "npm_config_node_linker": "hoisted"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "22.19.0",
      "env": {
        "EAS_NO_VCS": "1",
        "npm_config_node_linker": "hoisted"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "node": "22.19.0",
      "env": {
        "npm_config_node_linker": "hoisted"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
