{
  "name": "tabcom",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "mobile:start": "cd apps/mobile && expo start --clear",
    "mobile:android": "cd apps/mobile && expo run:android"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "turbo": "^2.10.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "pnpm": {
    "overrides": {
      "react-native-worklets": "0.10.2"
    }
  }
}